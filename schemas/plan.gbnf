blueprint ::= "{" space blueprint-sections-kv "," space blueprint-total-words-kv ( "," space ( blueprint-abstention-kv ) )? space "}"
blueprint-abstention-kv ::= "\"abstention\"" space ":" space string
blueprint-kv ::= "\"blueprint\"" space ":" space blueprint
blueprint-sections ::= "[" space (blueprint-sections-item ("," space blueprint-sections-item)*)? space "]"
blueprint-sections-item ::= "{" space blueprint-sections-item-title-kv "," space blueprint-sections-item-purpose-kv ( "," space ( blueprint-sections-item-evidence-needed-kv blueprint-sections-item-evidence-needed-rest | blueprint-sections-item-word-budget-kv ) )? space "}"
blueprint-sections-item-evidence-needed ::= "[" space (string ("," space string)*)? space "]"
blueprint-sections-item-evidence-needed-kv ::= "\"evidence_needed\"" space ":" space blueprint-sections-item-evidence-needed
blueprint-sections-item-evidence-needed-rest ::= ( "," space blueprint-sections-item-word-budget-kv )?
blueprint-sections-item-purpose-kv ::= "\"purpose\"" space ":" space string
blueprint-sections-item-title-kv ::= "\"title\"" space ":" space string
blueprint-sections-item-word-budget-kv ::= "\"word_budget\"" space ":" space number
blueprint-sections-kv ::= "\"sections\"" space ":" space blueprint-sections
blueprint-total-words-kv ::= "\"total_words\"" space ":" space number
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
root ::= "{" space blueprint-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
