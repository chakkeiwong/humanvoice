{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanvoice.local/schema/v2/source-concept.schema.json",
  "title": "Humanvoice v2 source concept",
  "$comment": "The shared record validator verifies identity_hash from the immutable source hash plus ordered source span identities and checks every occurrence and obligation link.",
  "type": "object",
  "required": ["record_type", "schema_version", "record_id", "run_id", "created_at", "baseline_id", "snapshot_id", "concept_id", "identity_basis", "proposition", "concept_type", "source_span_ids", "occurrences", "supporting_claims", "evidence_ids", "protected_object_ids", "assumptions", "qualifications", "reader_prerequisites", "explanation_obligation_ids", "extraction_confidence", "review_status", "lineage"],
  "properties": {
    "record_type": {"const": "SourceConcept"},
    "schema_version": {"type": "string", "pattern": "^HV-SCHEMA-2\\.[0-9]+$"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "baseline_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "concept_id": {"type": "string", "minLength": 1},
    "identity_basis": {"type": "object", "required": ["snapshot_hash", "ordered_span_ids_hash", "identity_hash"], "properties": {"snapshot_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "ordered_span_ids_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "identity_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}, "additionalProperties": false},
    "proposition": {"type": "string", "minLength": 1},
    "concept_type": {"enum": ["definition", "distinction", "claim", "mechanism", "assumption", "derivation_step", "qualification", "example", "counterexample", "evidence_interpretation", "teaching_transition", "other"]},
    "source_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "occurrences": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["span_id", "teaching_role"], "properties": {"span_id": {"type": "string", "minLength": 1}, "teaching_role": {"enum": ["introduce", "define", "motivate", "derive", "illustrate", "contrast", "qualify", "interpret", "recall", "transition", "other"]}}, "additionalProperties": false}},
    "supporting_claims": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "protected_object_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "qualifications": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reader_prerequisites": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "explanation_obligation_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "extraction_confidence": {"type": "number", "minimum": 0, "maximum": 1, "description": "Diagnostic only; never establishes completeness or acceptance."},
    "review_status": {"enum": ["proposed", "accepted", "ambiguous", "rejected"]},
    "lineage": {"type": "object", "required": ["parent_concept_ids", "change_reason", "adjudicated_by", "adjudicated_at"], "properties": {"parent_concept_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "change_reason": {"type": ["string", "null"]}, "adjudicated_by": {"type": ["string", "null"]}, "adjudicated_at": {"type": ["string", "null"], "format": "date-time"}}, "additionalProperties": false},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
