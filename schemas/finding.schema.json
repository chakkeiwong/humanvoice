{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanvoice.local/schema/v2/finding.schema.json",
  "title": "Humanvoice v2 located finding",
  "type": "object",
  "required": ["record_type", "schema_version", "record_id", "run_id", "created_at", "finding_id", "category", "construct", "source_locations", "candidate_locations", "observation", "consequence", "question", "rule_version", "critic", "verdict", "severity", "blocking", "concept_ids", "obligation_ids", "status", "resolution"],
  "properties": {
    "record_type": {"const": "Finding"},
    "schema_version": {"type": "string", "pattern": "^HV-SCHEMA-2\\.[0-9]+$"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "finding_id": {"type": "string", "minLength": 1},
    "category": {"enum": ["span_coverage", "concept_correspondence", "explanation_obligation", "dependency_order", "qualification_scope", "unsupported_addition", "scaffolding", "protected_object", "source_integrity", "assembly", "build", "policy", "transmission", "reader_comprehension", "other"]},
    "construct": {"type": "string", "minLength": 1},
    "source_locations": {"type": "array", "items": {"$ref": "#/$defs/location"}},
    "candidate_locations": {"type": "array", "items": {"$ref": "#/$defs/location"}},
    "observation": {"type": "string", "minLength": 1},
    "consequence": {"type": "string", "minLength": 1},
    "question": {"type": ["string", "null"]},
    "rule_version": {"type": "string", "minLength": 1},
    "critic": {"type": "object", "required": ["critic_id", "critic_kind", "version", "prompt_hash", "calibration_record_id", "independent_of_writer"], "properties": {"critic_id": {"type": "string", "minLength": 1}, "critic_kind": {"enum": ["deterministic", "model", "human"]}, "version": {"type": "string", "minLength": 1}, "prompt_hash": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"}, "calibration_record_id": {"type": ["string", "null"]}, "independent_of_writer": {"type": "boolean"}}, "additionalProperties": false},
    "verdict": {"enum": ["supported", "contradicted", "unresolved"]},
    "severity": {"enum": ["diagnostic", "blocking"]},
    "blocking": {"type": "boolean"},
    "concept_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "obligation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "status": {"enum": ["open", "resolved", "adjudication_required", "superseded"]},
    "resolution": {"type": ["object", "null"], "required": ["action", "record_ids", "resolved_by", "resolved_at", "reason"], "properties": {"action": {"enum": ["repair", "baseline_amendment", "obligation_deactivation", "finding_rejected", "manual_revision"]}, "record_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "resolved_by": {"type": "string", "minLength": 1}, "resolved_at": {"type": "string", "format": "date-time"}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "extensions": {"type": "object"}
  },
  "$defs": {"location": {"type": "object", "required": ["path", "byte_start", "byte_end", "text_hash"], "properties": {"path": {"type": "string", "minLength": 1}, "byte_start": {"type": "integer", "minimum": 0}, "byte_end": {"type": "integer", "minimum": 1}, "text_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}, "additionalProperties": false}},
  "allOf": [
    {"if": {"properties": {"severity": {"const": "blocking"}}}, "then": {"properties": {"blocking": {"const": true}}}},
    {"if": {"properties": {"status": {"const": "resolved"}}}, "then": {"properties": {"resolution": {"type": "object"}}}, "else": {"properties": {"resolution": {"type": "null"}}}},
    {"if": {"properties": {"critic": {"properties": {"critic_kind": {"const": "model"}}}}}, "then": {"properties": {"critic": {"properties": {"prompt_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "calibration_record_id": {"type": "string", "minLength": 1}, "independent_of_writer": {"const": true}}}}}}
  ],
  "additionalProperties": false
}
