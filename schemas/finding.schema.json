{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanvoice.local/schema/finding.schema.json",
  "title": "Humanvoice finding",
  "type": "object",
  "required": ["record_type", "schema_version", "record_id", "run_id", "created_at", "category", "location", "observation", "consequence", "question", "rule_version", "author_decision", "status"],
  "properties": {
    "record_type": {"const": "Finding"},
    "schema_version": {"type": "string", "pattern": "^HV-SCHEMA-[0-9]+\\.[0-9]+$"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "category": {"type": "string", "minLength": 1},
    "location": {"type": "object"},
    "observation": {"type": "string", "minLength": 1},
    "consequence": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "question": {"type": "string", "minLength": 1},
    "rule_version": {"type": "string", "minLength": 1},
    "author_decision": {"enum": ["accept", "reject", "defer", "rewrite", "pending"]},
    "status": {"enum": ["open", "accepted", "rejected", "deferred", "abstained"]},
    "repair_strategy": {"type": ["string", "null"]},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
