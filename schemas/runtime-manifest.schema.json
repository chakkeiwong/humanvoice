{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanvoice.local/schema/v2/runtime-manifest.schema.json",
  "title": "Humanvoice v2 runtime manifest",
  "type": "object",
  "required": ["record_type", "schema_version", "record_id", "run_id", "created_at", "activity", "runtime_type", "tool_version", "compiler", "model_version_string", "prompt_template_hash", "policy_snapshot_hash", "schema_hash", "sampling", "api_endpoint", "request_id_if_available", "authorization_record_id", "transmission_record_id", "started_at", "latency_ms", "input_tokens", "output_tokens", "output_hash", "termination", "network_policy", "resource_limits"],
  "properties": {
    "record_type": {"const": "RuntimeManifest"},
    "schema_version": {"type": "string", "pattern": "^HV-SCHEMA-2\\.[0-9]+$"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "activity": {"enum": ["parse", "build", "inventory", "plan", "rewrite", "critic", "repair", "assemble", "release"]},
    "runtime_type": {"enum": ["deterministic-only", "anthropic-messages-api"]},
    "tool_version": {"type": "string", "minLength": 1},
    "compiler": {"type": ["object", "null"], "required": ["name", "version", "executable_sha256", "flags"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "executable_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "flags": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
    "model_version_string": {"type": ["string", "null"]},
    "prompt_template_hash": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
    "policy_snapshot_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "schema_hash": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
    "sampling": {"type": ["object", "null"]},
    "api_endpoint": {"type": ["string", "null"]},
    "request_id_if_available": {"type": ["string", "null"]},
    "authorization_record_id": {"type": ["string", "null"]},
    "transmission_record_id": {"type": ["string", "null"]},
    "started_at": {"type": "string", "format": "date-time"},
    "latency_ms": {"type": "number", "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "termination": {"enum": ["complete", "truncated", "timeout", "resource_exhausted", "schema_invalid", "error"]},
    "network_policy": {"enum": ["deny", "anthropic-api-only"]},
    "resource_limits": {"type": "object", "required": ["wall_clock_seconds", "max_output_tokens", "max_memory_mib"], "properties": {"wall_clock_seconds": {"type": "integer", "minimum": 1}, "max_output_tokens": {"type": ["integer", "null"], "minimum": 1}, "max_memory_mib": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "extensions": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"runtime_type": {"const": "deterministic-only"}}}, "then": {"properties": {"model_version_string": {"type": "null"}, "prompt_template_hash": {"type": "null"}, "schema_hash": {"type": "null"}, "sampling": {"type": "null"}, "api_endpoint": {"type": "null"}, "request_id_if_available": {"type": "null"}, "authorization_record_id": {"type": "null"}, "transmission_record_id": {"type": "null"}, "input_tokens": {"type": "null"}, "output_tokens": {"type": "null"}, "network_policy": {"const": "deny"}, "resource_limits": {"properties": {"max_output_tokens": {"type": "null"}}}}}},
    {"if": {"properties": {"runtime_type": {"const": "anthropic-messages-api"}}}, "then": {"properties": {"model_version_string": {"type": "string", "minLength": 1}, "prompt_template_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "schema_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "sampling": {"type": "object"}, "api_endpoint": {"const": "https://api.anthropic.com/v1/messages"}, "authorization_record_id": {"type": "string", "minLength": 1}, "transmission_record_id": {"type": "string", "minLength": 1}, "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "network_policy": {"const": "anthropic-api-only"}, "resource_limits": {"properties": {"max_output_tokens": {"type": "integer", "minimum": 1}}}}}},
    {"if": {"properties": {"activity": {"const": "build"}}}, "then": {"properties": {"compiler": {"type": "object", "properties": {"flags": {"contains": {"const": "-no-shell-escape"}}}}}}}
  ],
  "additionalProperties": false
}
