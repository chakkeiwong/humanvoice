{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanvoice.local/schema/v2/source-snapshot.schema.json",
  "title": "Humanvoice v2 immutable source snapshot",
  "$comment": "The shared record validator verifies every file digest, the sorted tree digest, the entry-point membership, and read-only filesystem state before downstream work.",
  "type": "object",
  "required": ["record_type", "schema_version", "record_id", "run_id", "created_at", "snapshot_id", "source_hash", "source_entry_point", "source_files", "source_tree_bytes", "humanization_brief_id", "humanization_brief_hash", "brief_valid", "snapshot_immutable", "snapshot_closed_at", "privacy_class"],
  "properties": {
    "record_type": {"const": "SourceSnapshot"},
    "schema_version": {"type": "string", "pattern": "^HV-SCHEMA-2\\.[0-9]+$"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "source_entry_point": {"type": "string", "minLength": 1},
    "source_files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256", "byte_size"], "properties": {"path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "byte_size": {"type": "integer", "minimum": 0}}, "additionalProperties": false}},
    "source_tree_bytes": {"type": "integer", "minimum": 1},
    "humanization_brief_id": {"type": "string", "minLength": 1},
    "humanization_brief_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "brief_valid": {"const": true},
    "snapshot_immutable": {"const": true},
    "snapshot_closed_at": {"type": "string", "format": "date-time"},
    "source_root": {"type": ["string", "null"]},
    "scratch_path": {"type": ["string", "null"]},
    "privacy_class": {"enum": ["public", "internal", "confidential", "restricted"]},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
