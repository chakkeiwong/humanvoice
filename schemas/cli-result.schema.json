{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanvoice.local/schema/v2/cli-result.schema.json",
  "title": "Humanvoice v2 CLI result",
  "type": "object",
  "required": ["record_type", "schema_version", "record_id", "run_id", "created_at", "contract_id", "contract_version", "command", "status", "exit_code", "record_paths", "blocking_reasons", "source_hash", "result_hash"],
  "properties": {
    "record_type": {"const": "CliResult"},
    "schema_version": {"type": "string", "pattern": "^HV-SCHEMA-2\\.[0-9]+$"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "contract_id": {"const": "HV-IC-2026-09-11"},
    "contract_version": {"const": "2.0.0"},
    "command": {"enum": ["hv humanize", "hv init", "hv inventory", "hv plan", "hv rewrite", "hv preflight", "hv repair", "hv assemble", "hv release"]},
    "status": {"enum": ["pass", "blocked", "abstain", "paused", "error", "candidate-ready", "released"]},
    "exit_code": {"type": "integer", "minimum": 0, "maximum": 5},
    "record_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "blocking_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "result_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "extensions": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"exit_code": {"const": 0}}}, "then": {"properties": {"status": {"enum": ["pass", "candidate-ready", "released"]}, "blocking_reasons": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"enum": ["blocked", "abstain", "paused", "error"]}}}, "then": {"properties": {"blocking_reasons": {"minItems": 1}}}}
  ],
  "additionalProperties": false
}
