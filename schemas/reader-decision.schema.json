{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanvoice.local/schema/v2/reader-decision.schema.json",
  "title": "Humanvoice v2 independent reader decision",
  "type": "object",
  "required": ["record_type", "schema_version", "record_id", "run_id", "created_at", "reader_id", "reader_name", "reader_role", "technical_qualification", "independent_from_rule_tuning", "repository_context_used", "prior_exposure", "assignment", "reader_packet_hash", "source_document_hash", "revised_document_hash", "baseline_id", "revision_id", "rubric_responses", "comfort", "elapsed_minutes", "decision", "requested_changes"],
  "properties": {
    "record_type": {"const": "ReaderDecision"},
    "schema_version": {"type": "string", "pattern": "^HV-SCHEMA-2\\.[0-9]+$"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "reader_id": {"type": "string", "minLength": 1},
    "reader_name": {"type": "string", "minLength": 1},
    "reader_role": {"type": "string", "minLength": 1},
    "technical_qualification": {"type": "string", "minLength": 1},
    "independent_from_rule_tuning": {"const": true},
    "repository_context_used": {"const": false},
    "prior_exposure": {"enum": ["none", "topic-familiar", "project-familiar", "author-familiar"]},
    "assignment": {"enum": ["source", "revision", "paired-comparison"]},
    "reader_packet_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "source_document_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "revised_document_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "baseline_id": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "rubric_responses": {"type": "array", "minItems": 6, "items": {"type": "object", "required": ["question_id", "construct", "response", "confidence", "adjudication", "failure_locations"], "properties": {"question_id": {"type": "string", "minLength": 1}, "construct": {"enum": ["problem", "mechanism", "evidence", "distinction", "assumption", "qualification", "limitation", "derivation", "action"]}, "response": {"type": "string", "minLength": 1}, "confidence": {"enum": ["high", "medium", "low"]}, "adjudication": {"enum": ["correct", "partial", "incorrect", "not_scored"]}, "failure_locations": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}},
    "comfort": {"type": "object", "required": ["rating", "reread_locations", "stop_locations", "comments"], "properties": {"rating": {"type": "integer", "minimum": 1, "maximum": 5}, "reread_locations": {"type": "array", "items": {"type": "string", "minLength": 1}}, "stop_locations": {"type": "array", "items": {"type": "string", "minLength": 1}}, "comments": {"type": "string"}}, "additionalProperties": false},
    "elapsed_minutes": {"type": "number", "minimum": 0},
    "decision": {"enum": ["accept", "request-revision", "decline"]},
    "requested_changes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "extensions": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "accept"}}}, "then": {"properties": {"requested_changes": {"maxItems": 0}, "rubric_responses": {"items": {"properties": {"adjudication": {"enum": ["correct", "not_scored"]}}}}}}},
    {"if": {"properties": {"decision": {"enum": ["request-revision", "decline"]}}}, "then": {"properties": {"requested_changes": {"minItems": 1}}}}
  ],
  "additionalProperties": false
}
