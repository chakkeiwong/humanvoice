{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanvoice.local/schema/v2/scaffolding-disposition.schema.json",
  "title": "Humanvoice v2 scaffolding disposition",
  "$comment": "The shared record validator checks that embedded concepts and their preservation dispositions exist in the same baseline before move_backstage or remove_nonconcept can be accepted.",
  "type": "object",
  "required": ["record_type", "schema_version", "record_id", "run_id", "created_at", "baseline_id", "disposition_id", "source_span_ids", "disposition", "reader_relevance_reason", "embedded_concept_ids", "backstage_target", "review_status", "adjudication"],
  "properties": {
    "record_type": {"const": "ScaffoldingDisposition"},
    "schema_version": {"type": "string", "pattern": "^HV-SCHEMA-2\\.[0-9]+$"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "baseline_id": {"type": "string", "minLength": 1},
    "disposition_id": {"type": "string", "minLength": 1},
    "source_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "disposition": {"enum": ["retain_domain_content", "move_backstage", "remove_nonconcept", "unresolved"]},
    "reader_relevance_reason": {"type": "string", "minLength": 1},
    "embedded_concept_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "backstage_target": {"type": ["string", "null"]},
    "review_status": {"enum": ["proposed", "accepted", "rejected", "unresolved"]},
    "adjudication": {"type": ["object", "null"], "properties": {"reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "format": "date-time"}, "reason": {"type": "string", "minLength": 1}}, "required": ["reviewer", "reviewed_at", "reason"], "additionalProperties": false},
    "extensions": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"review_status": {"const": "accepted"}}}, "then": {"properties": {"adjudication": {"type": "object"}, "disposition": {"not": {"const": "unresolved"}}}}},
    {"if": {"properties": {"disposition": {"const": "move_backstage"}}}, "then": {"properties": {"backstage_target": {"type": "string", "minLength": 1}}}, "else": {"properties": {"backstage_target": {"type": "null"}}}},
    {"if": {"properties": {"disposition": {"const": "unresolved"}}}, "then": {"properties": {"review_status": {"const": "unresolved"}, "adjudication": {"type": "null"}}}}
  ],
  "additionalProperties": false
}
