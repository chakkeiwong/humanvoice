{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanvoice.local/schema/revision.schema.json",
  "title": "Humanvoice revision",
  "type": "object",
  "required": ["record_type", "schema_version", "record_id", "run_id", "created_at", "parent_hash", "child_hash", "changed_spans", "protected_comparison", "author_decision"],
  "properties": {
    "record_type": {"const": "Revision"},
    "schema_version": {"type": "string", "pattern": "^HV-SCHEMA-[0-9]+\\.[0-9]+$"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "parent_hash": {"type": "string", "minLength": 1},
    "child_hash": {"type": "string", "minLength": 1},
    "changed_spans": {"type": "array", "items": {"type": "object"}},
    "protected_comparison": {"type": "object"},
    "author_decision": {"enum": ["accepted", "rejected", "deferred", "manual-rewrite"]},
    "repair_strategy": {"type": ["string", "null"]},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
