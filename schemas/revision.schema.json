{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humanvoice.local/schema/v2/revision.schema.json",
  "title": "Humanvoice v2 child revision",
  "$comment": "The shared record validator verifies expected source hashes, non-overlap, descending patch application, explicit move lineage, and byte identity outside patches.",
  "type": "object",
  "required": ["record_type", "schema_version", "record_id", "run_id", "created_at", "revision_id", "baseline_id", "baseline_hash", "snapshot_id", "source_hash", "parent_revision_id", "parent_hash", "child_hash", "candidate_tree", "patches", "untouched_bytes_verified", "protected_comparison_path", "correspondence_paths", "status", "decision_by", "decision_at"],
  "properties": {
    "record_type": {"const": "Revision"},
    "schema_version": {"type": "string", "pattern": "^HV-SCHEMA-2\\.[0-9]+$"},
    "record_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "revision_id": {"type": "string", "minLength": 1},
    "baseline_id": {"type": "string", "minLength": 1},
    "baseline_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "parent_revision_id": {"type": ["string", "null"]},
    "parent_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "child_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "candidate_tree": {"type": "string", "minLength": 1},
    "patches": {"type": "array", "items": {"type": "object", "required": ["patch_id", "source_file", "byte_start", "byte_end", "expected_text_hash", "replacement_hash", "operation", "rewrite_unit_ids", "move_target"], "properties": {"patch_id": {"type": "string", "minLength": 1}, "source_file": {"type": "string", "minLength": 1}, "byte_start": {"type": "integer", "minimum": 0}, "byte_end": {"type": "integer", "minimum": 1}, "expected_text_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "replacement_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "operation": {"enum": ["replace", "move"]}, "rewrite_unit_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "move_target": {"type": ["object", "null"], "properties": {"target_file": {"type": "string", "minLength": 1}, "target_byte": {"type": "integer", "minimum": 0}}, "required": ["target_file", "target_byte"], "additionalProperties": false}}, "additionalProperties": false}},
    "untouched_bytes_verified": {"type": "boolean"},
    "protected_comparison_path": {"type": "string", "minLength": 1},
    "correspondence_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "status": {"enum": ["proposed", "accepted", "rejected", "failed", "unresolved"]},
    "decision_by": {"type": ["string", "null"]},
    "decision_at": {"type": ["string", "null"], "format": "date-time"},
    "failure_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "extensions": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "accepted"}}}, "then": {"properties": {"untouched_bytes_verified": {"const": true}, "decision_by": {"type": "string", "minLength": 1}, "decision_at": {"type": "string", "format": "date-time"}, "failure_reasons": {"maxItems": 0}}}},
    {"if": {"properties": {"patches": {"contains": {"properties": {"operation": {"const": "move"}}, "required": ["operation"]}}}}, "then": {"properties": {"patches": {"items": {"if": {"properties": {"operation": {"const": "move"}}}, "then": {"properties": {"move_target": {"type": "object"}}}}}}}}
  ],
  "additionalProperties": false
}
