char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
decimal-part ::= [0-9]{1,16}
draft ::= "{" space draft-latex-kv "," space draft-word-count-kv ( "," space ( draft-citations-needed-kv draft-citations-needed-rest | draft-abstention-kv ) )? space "}"
draft-abstention-kv ::= "\"abstention\"" space ":" space string
draft-citations-needed ::= "[" space (string ("," space string)*)? space "]"
draft-citations-needed-kv ::= "\"citations_needed\"" space ":" space draft-citations-needed
draft-citations-needed-rest ::= ( "," space draft-abstention-kv )?
draft-kv ::= "\"draft\"" space ":" space draft
draft-latex-kv ::= "\"latex\"" space ":" space string
draft-word-count-kv ::= "\"word_count\"" space ":" space number
integral-part ::= [0] | [1-9] [0-9]{0,15}
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
root ::= "{" space draft-kv space "}"
space ::= | " " | "\n"{1,2} [ \t]{0,20}
string ::= "\"" char* "\""
